{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=paper;Username=paper;Password=paper;Maximum Pool Size=10"
  },
  "Storage": {
    "Provider": "local",
    "RootPath": "data/documents",
    "SmbRootPath": "",
    "WakePolicy": "Never"
  },
  "DataProtection": {
    "KeysDirectory": "data/keys"
  },
  "Auth": {
    "Username": "admin",
    "Password": "change-me"
  },
  "Ocr": {
    "ExecutablePath": "tesseract",
    "PdfTextExecutablePath": "pdftotext",
    "PdfRenderExecutablePath": "pdftoppm",
    "PdfRenderDpi": 200,
    "Language": "eng"
  },
  "Processing": {
    "OcrWorkers": 1,
    "AnalysisWorkers": 1,
    "PollSeconds": 3
  },
  "Consume": {
    "RootPath": "data/consume",
    "PollSeconds": 15,
    "EmailAttachments": true
  },
  "Mail": {
    "Enabled": false,
    "AccountName": "default",
    "Host": "",
    "Port": 993,
    "UseSsl": true,
    "Username": "",
    "Password": "",
    "Folder": "INBOX",
    "PollSeconds": 300,
    "MaxMessagesPerRun": 10,
    "OnlyUnread": true,
    "MarkSeen": false,
    "FromContains": "",
    "SubjectContains": "",
    "AttachmentExtensions": ".pdf,.jpg,.jpeg,.png,.tif,.tiff"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
