@page "/Settings"
@model Paper.Web.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "Einstellungen";
}
<header class="page-header"><div><div class="eyebrow">System</div><h1>Einstellungen</h1><p class="muted">Die wichtigsten Laufzeitinformationen deines Archivs.</p></div></header>
<section class="panel settings-list">
    <div><span class="muted">Lokaler Speicher</span><strong>@Model.StoragePath</strong></div>
    <div><span class="muted">OCR-Sprache</span><strong>@Model.OcrLanguage</strong></div>
    <div><span class="muted">Verarbeitung</span><strong>Persistente PostgreSQL-Jobs</strong></div>
</section>
