@page "/Settings"
@model Paper.Web.Pages.Settings.IndexModel
@using Paper.Web.Features.CustomFields
@{
    ViewData["Title"] = "Einstellungen";
}
<header class="page-header"><div><div class="eyebrow">System</div><h1>Einstellungen</h1><p class="muted">Stammdaten und Laufzeitinformationen deines Archivs.</p></div></header>
<section class="panel settings-list">
    <div><span class="muted">Lokaler Speicher</span><strong>@Model.StoragePath</strong></div>
    <div><span class="muted">Storage-Provider</span><strong>@Model.StorageProvider</strong></div>
    <div><span class="muted">NAS-Wake-Policy</span><strong>@Model.WakePolicy</strong></div>
    <div><span class="muted">OCR-Sprache</span><strong>@Model.OcrLanguage</strong></div>
    <div><span class="muted">Verarbeitung</span><strong>Persistente PostgreSQL-Jobs</strong></div>
    <div><span class="muted">Export und Backup</span><span><a class="button" href="/export/documents.json">JSON</a> <a class="button" href="/export/documents.csv">CSV</a> <a class="button" href="/export/backup.zip">ZIP-Backup</a></span></div>
</section>
<section class="panel settings-card restore-card">
    <h2>Speicherprüfung</h2>
    <p class="muted">Prüft, ob jedes in der Datenbank bekannte Dokument noch am registrierten Speicherpfad vorhanden ist. Es werden keine Dateien verändert.</p>
    <form method="post" asp-page-handler="CheckStorage">
        <button class="button button-primary" type="submit">Speicher jetzt prüfen</button>
    </form>
    @if (Model.IntegrityReport is not null)
    {
        var report = Model.IntegrityReport;
        <div class="integrity-result @(report.IsHealthy ? "integrity-ok" : "integrity-warning")" role="status">
            <strong>@report.DocumentsChecked Dokument(e) geprüft</strong>
            @if (report.Error is not null)
            {
                <span>Prüfung wegen eines Speicherfehlers beendet: @report.Error</span>
            }
            else if (report.IsHealthy)
            {
                <span>Alle Dateien sind vorhanden.</span>
            }
            else
            {
                <span>@report.MissingFiles fehlende Datei(en), @report.SizeMismatches Datei(en) mit abweichender Größe.</span>
            }
        </div>
        @if (report.Issues.Count > 0)
        {
            <ul class="integrity-issues">
                @foreach (var issue in report.Issues)
                {
                    <li>
                        <strong>@issue.Title</strong>
                        <span class="small muted">@issue.FilePath · @(issue.Kind == Paper.Web.Features.Storage.StorageIntegrityIssueKind.Missing ? "Datei fehlt" : $"Größe {issue.ActualSize} statt {issue.ExpectedSize} Bytes")</span>
                    </li>
                }
            </ul>
            @if (report.MissingFiles + report.SizeMismatches > report.Issues.Count)
            {
                <p class="small muted">Es werden höchstens @Paper.Web.Features.Storage.StorageIntegrityService.MaximumReportedIssues Auffälligkeiten angezeigt.</p>
            }
        }
    }
    <div asp-validation-summary="ModelOnly" class="validation"></div>
</section>
<div class="settings-grid">
    <section class="panel settings-card">
        <h2>Korrespondenten</h2>
        <form method="post" asp-page-handler="CreateCorrespondent" class="inline-form">
            <input asp-for="CorrespondentName" placeholder="z. B. Stadtwerke Mannheim" />
            <button class="button button-primary" type="submit">Hinzufügen</button>
        </form>
        <div class="settings-tags">@foreach (var item in Model.CorrespondentOptions) { <span class="tag">@item.Name</span> }</div>
    </section>
    <section class="panel settings-card">
        <h2>Dokumenttypen</h2>
        <form method="post" asp-page-handler="CreateDocumentType" class="inline-form">
            <input asp-for="DocumentTypeName" placeholder="z. B. Rechnung" />
            <button class="button button-primary" type="submit">Hinzufügen</button>
        </form>
        <div class="settings-tags">@foreach (var item in Model.DocumentTypeOptions) { <span class="tag">@item.Name</span> }</div>
    </section>
    <section class="panel settings-card">
        <h2>Zusatzfelder</h2>
        <form method="post" asp-page-handler="CreateCustomField" class="stack">
            <input asp-for="CustomFieldName" placeholder="z. B. Vertragsnummer" />
            <select asp-for="CustomFieldType">
                @foreach (var type in Enum.GetValues<CustomFieldType>())
                {
                    <option value="@type">@type</option>
                }
            </select>
            <button class="button button-primary" type="submit">Hinzufügen</button>
        </form>
        <div class="settings-tags">@foreach (var item in Model.CustomFieldOptions) { <span class="tag">@item.Name · @item.Type</span> }</div>
    </section>
    <section class="panel settings-card">
        <h2>Tags</h2>
        <form method="post" asp-page-handler="CreateTag" class="inline-form">
            <input asp-for="TagName" placeholder="z. B. steuer" />
            <button class="button button-primary" type="submit">Hinzufügen</button>
        </form>
        @if (Model.TagOptions.Count == 0)
        {
            <p class="small muted">Noch keine Tags vorhanden.</p>
        }
        else
        {
            <div class="settings-tags">
                @foreach (var item in Model.TagOptions)
                {
                    <span class="tag">@item.Name · @item.DocumentCount Dok.</span>
                    <form method="post" asp-page-handler="DeleteTag" class="inline-form" onsubmit="return confirm('Tag entfernen? Er wird von allen Dokumenten gelöst.');">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button class="button button-quiet" type="submit" aria-label="Tag @item.Name entfernen">×</button>
                    </form>
                }
            </div>
        }
    </section>
</div>
<section class="panel settings-card restore-card">
    <h2>Gelernte Analyse</h2>
    <p class="muted">Paper merkt sich wiederkehrende Korrekturen. Die Regeln bleiben sichtbar und können einzeln entfernt werden.</p>
    @if (Model.AnalysisRules.Count == 0)
    {
        <p class="small muted">Noch keine Lernregeln vorhanden.</p>
    }
    else
    {
        <div class="analysis-rules">
            @foreach (var rule in Model.AnalysisRules)
            {
                <div class="analysis-rule">
                    <div>
                        <strong>@rule.Term</strong>
                        <span class="small muted">@rule.UseCount Verwendung(en) · @rule.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy")</span>
                        <span class="small muted">@(rule.Correspondent ?? "")@(rule.DocumentType is null ? "" : $" · {rule.DocumentType}")@(rule.ShelfPath is null ? "" : $" · {rule.ShelfPath}")</span>
                    </div>
                    <form method="post" asp-page-handler="DeleteAnalysisRule">
                        <input type="hidden" name="id" value="@rule.Id" />
                        <button class="button button-quiet" type="submit">Entfernen</button>
                    </form>
                </div>
            }
        </div>
    }
</section>
<section class="panel settings-card restore-card">
    <h2>Backup wiederherstellen</h2>
    <p class="muted">Importiert Dateien und Metadaten aus einem Paper-ZIP-Backup. Vorhandene Hashes werden übersprungen.</p>
    <form method="post" asp-page-handler="Restore" enctype="multipart/form-data" class="inline-form">
        <input asp-for="Backup" accept=".zip" />
        <button class="button button-primary" type="submit">Backup importieren</button>
    </form>
    <div asp-validation-summary="ModelOnly" class="validation"></div>
</section>
<section class="panel settings-card restore-card">
    <h2>Mailimport</h2>
    <p class="muted">Der IMAP-Import ist @(Model.MailEnabled ? "aktiviert" : "deaktiviert").</p>
    @if (Model.MailConfigurationError is not null)
    {
        <p class="error-text">Mail-Konfiguration ungültig: @Model.MailConfigurationError</p>
    }
    @if (Model.MailStates.Count > 0)
    {
        @foreach (var state in Model.MailStates)
        {
            <p class="small muted"><strong>@state.AccountName</strong> · Letzte UID: @state.LastUid · Letzte Ausführung: @(state.LastSyncAt?.ToLocalTime().ToString("g") ?? "noch nie")</p>
            @if (!string.IsNullOrWhiteSpace(state.LastError))
            {
                <p class="error-text">Letzter Fehler (@state.AccountName): @state.LastError</p>
            }
        }
    }
    <form method="post" asp-page-handler="RunMailImport">
        <button class="button button-primary" type="submit">Jetzt abrufen</button>
    </form>
    @if (Model.MailFailures.Count > 0)
    {
        <details class="mail-failures">
            <summary>Letzte Mailfehler (@Model.MailFailures.Count)</summary>
            <ul>
                @foreach (var failure in Model.MailFailures)
                {
                    <li><span class="muted">@failure.CreatedAt.ToLocalTime().ToString("g") · UID @failure.Uid</span> — @failure.Error</li>
                }
            </ul>
        </details>
    }
    <div asp-validation-summary="ModelOnly" class="validation"></div>
</section>
<section class="panel settings-card restore-card">
    <h2>Paperless-ngx importieren</h2>
    <p class="muted">Importiert unterstützte Paperless-Export-ZIPs in die Inbox. Die Dateien können danach geprüft und im Regal abgelegt werden.</p>
    <form method="post" asp-page-handler="ImportPaperless" enctype="multipart/form-data" class="inline-form">
        <input asp-for="PaperlessExport" accept=".zip" />
        <button class="button button-primary" type="submit">Paperless-Export importieren</button>
    </form>
    <div asp-validation-summary="ModelOnly" class="validation"></div>
</section>
