@page "/Settings"
@model Paper.Web.Pages.Settings.IndexModel
@using Paper.Web.Features.Storage
@{
    ViewData["Title"] = "Einstellungen";
}
<header class="page-header"><div><div class="eyebrow">System</div><h1>Einstellungen</h1><p class="muted">Archiv, Import und Verarbeitung.</p></div></header>
<div class="settings-shell">
    <partial name="_SettingsNavigation" model="@("general")" />
    <div class="settings-content">
        <section class="panel settings-card">
            <h2>Allgemein</h2>
            <div class="settings-list">
                <div><span class="muted">Speicher</span><strong>@(Model.Storage.ProviderType == StorageProviderType.Smb ? "NAS / SMB" : "Lokaler Speicher")</strong></div>
                <div><span class="muted">OCR-Sprache</span><strong>@Model.OcrLanguage</strong></div>
                <div><span class="muted">Verarbeitung</span><strong>Persistente PostgreSQL-Jobs</strong></div>
                <div><span class="muted">Export</span><span><a class="button" href="/export/documents.json">JSON</a> <a class="button" href="/export/documents.csv">CSV</a> <a class="button" href="/export/backup.zip">ZIP</a></span></div>
            </div>
        </section>
    </div>
</div>
