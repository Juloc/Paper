@page "/Settings/Processing"
@model Paper.Web.Pages.Settings.Processing.IndexModel
@{
    ViewData["Title"] = "Verarbeitung";
}
<header class="page-header"><div><div class="eyebrow">Settings</div><h1>Verarbeitung</h1><p class="muted">OCR, Analyse und Vorschau.</p></div></header>
<div class="settings-shell">
    <partial name="_SettingsNavigation" model="@("processing")" />
    <div class="settings-content">
        <section class="panel settings-card"><h2>Verarbeitung</h2><div class="settings-list"><div><span class="muted">OCR-Sprache</span><strong>@Model.OcrLanguage</strong></div><div><span class="muted">Jobs</span><strong>Persistente PostgreSQL-Jobs</strong></div><div><span class="muted">Thumbnail-Cache</span><strong>Erste Seite in PostgreSQL</strong></div></div><a class="button button-primary" asp-page="/Processing/Index">Verarbeitung öffnen</a></section>
    </div>
</div>
