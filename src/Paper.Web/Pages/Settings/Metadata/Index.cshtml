@page "/Settings/Metadata"
@model Paper.Web.Pages.Settings.Metadata.IndexModel
@using Paper.Web.Features.CustomFields
@{
    ViewData["Title"] = "Metadaten";
}
<header class="page-header"><div><div class="eyebrow">Settings</div><h1>Metadaten</h1><p class="muted">Katalogwerte und Tags.</p></div></header>
<div class="settings-shell">
    <partial name="_SettingsNavigation" model="@("metadata")" />
    <div class="settings-content settings-grid">
        <section class="panel settings-card"><h2>Korrespondenten</h2><form method="post" asp-page-handler="CreateCorrespondent" class="inline-form"><input asp-for="CorrespondentName" placeholder="z. B. Stadtwerke Mannheim" /><button class="button button-primary" type="submit">Hinzufügen</button></form><span asp-validation-for="CorrespondentName" class="validation"></span><div class="settings-tags">@foreach (var item in Model.CorrespondentOptions) { <span class="tag">@item.Name</span><form method="post" asp-page-handler="DeleteCorrespondent" class="inline-form"><input type="hidden" name="id" value="@item.Id" /><button class="button button-quiet" type="submit" aria-label="Korrespondent @item.Name entfernen">×</button></form> }</div></section>
        <section class="panel settings-card"><h2>Dokumenttypen</h2><form method="post" asp-page-handler="CreateDocumentType" class="inline-form"><input asp-for="DocumentTypeName" placeholder="z. B. Rechnung" /><button class="button button-primary" type="submit">Hinzufügen</button></form><span asp-validation-for="DocumentTypeName" class="validation"></span><div class="settings-tags">@foreach (var item in Model.DocumentTypeOptions) { <span class="tag">@item.Name</span><form method="post" asp-page-handler="DeleteDocumentType" class="inline-form"><input type="hidden" name="id" value="@item.Id" /><button class="button button-quiet" type="submit" aria-label="Dokumenttyp @item.Name entfernen">×</button></form> }</div></section>
        <section class="panel settings-card"><h2>Custom Fields</h2><form method="post" asp-page-handler="CreateCustomField" class="stack"><input asp-for="CustomFieldName" placeholder="z. B. Vertragsnummer" /><select asp-for="CustomFieldType">@foreach (var type in Enum.GetValues<CustomFieldType>()) { <option value="@type">@type</option> }</select><button class="button button-primary" type="submit">Hinzufügen</button></form><span asp-validation-for="CustomFieldName" class="validation"></span><div class="settings-tags">@foreach (var item in Model.CustomFieldOptions) { <span class="tag">@item.Name · @item.Type</span><form method="post" asp-page-handler="DeleteCustomField" class="inline-form"><input type="hidden" name="id" value="@item.Id" /><button class="button button-quiet" type="submit" aria-label="Zusatzfeld @item.Name entfernen">×</button></form> }</div></section>
        <section class="panel settings-card"><h2>Tags</h2><form method="post" asp-page-handler="CreateTag" class="inline-form"><input asp-for="TagName" placeholder="z. B. steuer" /><button class="button button-primary" type="submit">Hinzufügen</button></form><span asp-validation-for="TagName" class="validation"></span><div class="settings-tags">@foreach (var item in Model.TagOptions) { <span class="tag">@item.Name · @item.DocumentCount Dok.</span><form method="post" asp-page-handler="DeleteTag" class="inline-form"><input type="hidden" name="id" value="@item.Id" /><button class="button button-quiet" type="submit" aria-label="Tag @item.Name entfernen">×</button></form> }</div></section>
    </div>
</div>
