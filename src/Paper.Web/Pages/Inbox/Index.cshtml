@page "/Inbox"
@model Paper.Web.Pages.Inbox.IndexModel
@{
    ViewData["Title"] = "Inbox";
    var heading = Model.View switch { DocumentStatus.Deferred => "Später", DocumentStatus.Ignored => "Ignoriert", _ => "Inbox" };
}
<header class="page-header">
    <div><div class="eyebrow">Review-Workspace</div><h1>@heading</h1><p class="muted">Prüfe Metadaten, Vorschau und Regal in einem schnellen Durchlauf.</p></div>
    <span class="toolbar-meta">@Model.CurrentCount offen</span>
</header>
<nav class="inbox-tabs" aria-label="Inbox-Ansichten">
    <a class="@(Model.View == DocumentStatus.Inbox ? "active" : "")" asp-page="/Inbox/Index">Inbox</a>
    <a class="@(Model.View == DocumentStatus.Deferred ? "active" : "")" asp-page="/Inbox/Index" asp-route-view="Deferred">Später <span>@Model.DeferredCount</span></a>
    <a class="@(Model.View == DocumentStatus.Ignored ? "active" : "")" asp-page="/Inbox/Index" asp-route-view="Ignored">Ignoriert <span>@Model.IgnoredCount</span></a>
</nav>
@if (Model.Documents.Count == 0)
{
    <section class="empty-state"><h2>Deine Inbox ist leer</h2><p>Neue Uploads erscheinen hier nach der Verarbeitung.</p></section>
}
else
{
    <div class="workspace">
        <section class="panel inbox-queue" aria-label="Inbox-Queue">
            <div class="queue-heading"><h2>Queue</h2><span class="muted small">@Model.CurrentCount</span></div>
            @foreach (var document in Model.Documents)
            {
                <a class="queue-item @(Model.SelectedId == document.Id ? "active" : "")" asp-route-view="@Model.View" asp-route-pageNumber="@Model.PageNumber" asp-route-selectedId="@document.Id">
                    <span class="queue-thumb"><img src="/documents/@document.Id/thumbnail" alt="" loading="lazy" data-thumbnail /><span>PDF</span></span>
                    <span class="queue-copy"><strong>@document.Title</strong><span>@(document.Correspondent ?? "Ohne Korrespondent")</span><span>@(document.DocumentDate?.ToString("dd.MM.yyyy") ?? "Ohne Datum")</span></span>
                </a>
            }
        </section>
        <section class="panel inbox-preview-panel" aria-label="Dokumentvorschau">
            @if (Model.SelectedDocument is not null)
            {
                <div class="preview-toolbar"><div><strong>@Model.SelectedDocument.Title</strong><div class="muted small">@Model.SelectedDocument.OriginalFileName</div></div><span class="status status-@Model.SelectedDocument.OcrStatus.ToString().ToLowerInvariant()">@Model.SelectedDocument.OcrStatus</span></div>
                <div class="preview-canvas"><img src="/documents/@Model.SelectedDocument.Id/thumbnail" alt="Vorschau von @Model.SelectedDocument.Title" data-thumbnail /></div>
                <div class="preview-footer"><span class="muted small">Erste Seite · PDF-Vorschau</span><a class="button" href="/documents/@Model.SelectedDocument.Id/file" target="_blank" rel="noreferrer">PDF öffnen</a><a class="button" asp-page="/Documents/Detail" asp-route-id="@Model.SelectedDocument.Id">Details öffnen</a></div>
            }
            else
            {
                <div class="preview-empty">Wähle ein Dokument aus der Queue.</div>
            }
        </section>
        @if (Model.SelectedDocument is not null)
        {
            <aside class="panel inbox-meta" aria-label="Metadaten">
                <div class="meta-section"><h3>Metadaten</h3><span class="meta-label">Titel</span><span class="meta-value">@Model.SelectedDocument.Title</span><span class="meta-label">Korrespondent</span><span class="meta-value">@(Model.SelectedDocument.Correspondent ?? "Noch nicht erkannt")</span><span class="meta-label">Dokumenttyp</span><span class="meta-value">@(Model.SelectedDocument.DocumentType ?? "Noch nicht erkannt")</span><span class="meta-label">Datum</span><span class="meta-value">@(Model.SelectedDocument.DocumentDate?.ToString("dd.MM.yyyy") ?? "Noch nicht erkannt")</span></div>
                <div class="meta-section"><h3>Regal</h3><span class="meta-value">@(Model.SelectedDocument.ShelfPath ?? "Noch nicht abgelegt")</span><div class="tag-list">@foreach (var tag in Model.SelectedDocument.Tags) { <span class="tag">@tag</span> }</div></div>
                <div class="meta-section"><h3>Aktionen</h3><div class="inbox-actions"><a class="button button-primary" asp-page="/Documents/Detail" asp-route-id="@Model.SelectedDocument.Id">Ablegen</a><form method="post" asp-page-handler="Defer"><input type="hidden" name="id" value="@Model.SelectedDocument.Id" /><button class="button" type="submit">Später</button></form><form method="post" asp-page-handler="Ignore"><input type="hidden" name="id" value="@Model.SelectedDocument.Id" /><button class="button" type="submit">Ignorieren</button></form><form method="post" asp-page-handler="Reanalyze"><input type="hidden" name="id" value="@Model.SelectedDocument.Id" /><button class="button" type="submit">Neu analysieren</button></form></div></div>
            </aside>
        }
    </div>
}
