@page "/Inbox"
@model Paper.Web.Pages.Inbox.IndexModel
@{
    ViewData["Title"] = "Inbox";
}
<header class="page-header">
    <div>
        <div class="eyebrow">Zu prüfen</div>
        <h1>@(Model.View switch { DocumentStatus.Deferred => "Später", DocumentStatus.Ignored => "Ignoriert", _ => "Inbox" })</h1>
        <p class="muted">@(Model.View switch { DocumentStatus.Deferred => "Zurückgestellte Dokumente, die du später prüfen möchtest.", DocumentStatus.Ignored => "Ignorierte Dokumente bleiben erhalten und können wieder aufgenommen werden.", _ => "Neue Dokumente bleiben hier, bis du sie kurz prüfst und ablegst." })</p>
    </div>
    <a class="button button-primary" asp-page="/Add/Index">Dokument hinzufügen</a>
</header>
<nav class="inbox-tabs" aria-label="Inbox-Ansichten">
    <a class="@(Model.View == DocumentStatus.Inbox ? "active" : "")" asp-page="/Inbox/Index">Inbox</a>
    <a class="@(Model.View == DocumentStatus.Deferred ? "active" : "")" asp-page="/Inbox/Index" asp-route-view="Deferred">Später <span>@Model.DeferredCount</span></a>
    <a class="@(Model.View == DocumentStatus.Ignored ? "active" : "")" asp-page="/Inbox/Index" asp-route-view="Ignored">Ignoriert <span>@Model.IgnoredCount</span></a>
</nav>
@if (Model.Documents.Count == 0)
{
    <section class="empty-state">
        <h2>Deine Inbox ist leer</h2>
        <p>Neue Uploads erscheinen hier nach der Verarbeitung.</p>
    </section>
    @if (Model.PageCount > 1)
    {
        <nav class="pagination" aria-label="Inboxseiten">
            @if (Model.PageNumber > 1)
            {
                <a class="button" asp-route-view="@Model.View" asp-route-pageNumber="@(Model.PageNumber - 1)">Zurück</a>
            }
            <span class="muted">@Model.CurrentCount Dokument(e) · Seite @Model.PageNumber von @Model.PageCount</span>
            @if (Model.PageNumber < Model.PageCount)
            {
                <a class="button" asp-route-view="@Model.View" asp-route-pageNumber="@(Model.PageNumber + 1)">Weiter</a>
            }
        </nav>
    }
}
else
{
    <section class="document-list" aria-label="Dokumente in der Inbox">
        @foreach (var document in Model.Documents)
        {
            <article class="document-row">
                @if (document.OriginalFileName.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) || document.OriginalFileName.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) || document.OriginalFileName.EndsWith(".png", StringComparison.OrdinalIgnoreCase) || document.OriginalFileName.EndsWith(".tif", StringComparison.OrdinalIgnoreCase) || document.OriginalFileName.EndsWith(".tiff", StringComparison.OrdinalIgnoreCase))
                {
                    <img class="document-thumbnail" src="/documents/@document.Id/thumbnail" alt="" loading="lazy" />
                }
                else
                {
                    <div class="document-icon">@document.OriginalFileName.Split('.').Last().ToUpperInvariant()</div>
                }
                <div class="document-copy">
                    <a class="document-title" asp-page="/Documents/Detail" asp-route-id="@document.Id">@document.Title</a>
                    <span class="muted">@document.OriginalFileName · @($"{document.FileSize / 1024d / 1024d:0.0} MB")</span>
                    <div class="tag-list">
                        @foreach (var tag in document.Tags)
                        {
                            <span class="tag">@tag</span>
                        }
                    </div>
                </div>
                <div class="document-state">
                    <span class="status status-@document.OcrStatus.ToString().ToLowerInvariant()">@document.OcrStatus switch { OcrStatus.Pending => "Wartet auf OCR", OcrStatus.Processing => "Wird verarbeitet", OcrStatus.Completed => "OCR fertig", _ => "OCR fehlgeschlagen" }</span>
                    <div class="inbox-actions">
                        <a class="button button-primary" asp-page="/Documents/Detail" asp-route-id="@document.Id">@(Model.View == DocumentStatus.Inbox ? "Prüfen und ablegen" : "Öffnen")</a>
                        @if (Model.View == DocumentStatus.Inbox)
                        {
                            <form method="post" asp-page-handler="Defer"><input type="hidden" name="id" value="@document.Id" /><button class="button" type="submit">Später</button></form>
                            <form method="post" asp-page-handler="Ignore"><input type="hidden" name="id" value="@document.Id" /><button class="button button-quiet" type="submit">Ignorieren</button></form>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="Restore"><input type="hidden" name="id" value="@document.Id" /><button class="button" type="submit">In Inbox</button></form>
                        }
                    </div>
                </div>
            </article>
        }
    </section>
}
