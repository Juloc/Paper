@page "/Search"
@model Paper.Web.Pages.Search.IndexModel
@{
    ViewData["Title"] = "Suche";
}
<header class="page-header"><div><div class="eyebrow">Schnell finden</div><h1>Suche</h1><p class="muted">Titel, OCR-Text und Tags werden gemeinsam durchsucht.</p></div></header>
<form method="get" class="search-form">
    <input asp-for="Query" placeholder="Suchbegriff eingeben" autofocus />
    <button class="button button-primary" type="submit">Suchen</button>
</form>
@if (Model.Query.Length > 0)
{
    <p class="muted">@Model.Results.Count Ergebnis(se) für „@Model.Query“</p>
}
<section class="document-list">
    @foreach (var document in Model.Results)
    {
        <article class="document-row">
            <div class="document-icon">@document.OriginalFileName.Split('.').Last().ToUpperInvariant()</div>
            <div class="document-copy"><a class="document-title" asp-page="/Documents/Detail" asp-route-id="@document.Id">@document.Title</a><span class="muted">@document.OriginalFileName</span></div>
            <a class="button" asp-page="/Documents/Detail" asp-route-id="@document.Id">Öffnen</a>
        </article>
    }
</section>
