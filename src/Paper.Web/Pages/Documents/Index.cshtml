@page "/Documents"
@model Paper.Web.Pages.Documents.IndexModel
@{
    ViewData["Title"] = "Dokumente";
    var isList = string.Equals(Model.View, "list", StringComparison.OrdinalIgnoreCase);
}
<header class="page-header">
    <div><div class="eyebrow">Bibliothek</div><h1>Dokumente</h1><p class="muted">Dein kompletter, durchsuchbarer Bestand.</p></div>
</header>
<div class="document-toolbar">
    <span class="toolbar-meta">@Model.TotalCount Dokumente</span>
    <div class="view-switch" aria-label="Ansicht wechseln">
        <a class="@(!isList ? "active" : "")" asp-route-view="grid">▦ Grid</a>
        <a class="@(isList ? "active" : "")" asp-route-view="list">☷ Liste</a>
    </div>
</div>
@if (Model.Documents.Count == 0)
{
    <section class="empty-state"><h2>Noch keine abgelegten Dokumente</h2><p>Prüfe zuerst ein Dokument aus der Inbox.</p></section>
}
else if (isList)
{
    <section class="document-list" aria-label="Dokumentliste">
        @foreach (var document in Model.Documents)
        {
            <partial name="_DocumentListRow" model="document" />
        }
    </section>
}
else
{
    <section class="document-grid" aria-label="Dokumentkarten">
        @foreach (var document in Model.Documents)
        {
            <partial name="_DocumentCard" model="document" />
        }
    </section>
}
@if (Model.PageCount > 1)
{
    <nav class="pagination" aria-label="Dokumentseiten">
        @if (Model.PageNumber > 1) { <a class="button" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-view="@Model.View">Zurück</a> }
        <span class="muted">Seite @Model.PageNumber von @Model.PageCount</span>
        @if (Model.PageNumber < Model.PageCount) { <a class="button" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-view="@Model.View">Weiter</a> }
    </nav>
}
