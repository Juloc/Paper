# Required credentials. Replace every value before exposing Paper.
PAPER_ADMIN_USERNAME=admin
PAPER_ADMIN_PASSWORD=change-this-password
PAPER_POSTGRES_PASSWORD=change-this-database-password

# Storage: local is the default. For SMB use smb://server/share/path.
PAPER_STORAGE_PROVIDER=local
PAPER_STORAGE_SMB_ROOT_PATH=
PAPER_STORAGE_SMB_USERNAME=
PAPER_STORAGE_SMB_PASSWORD=
PAPER_STORAGE_SMB_DOMAIN=
PAPER_STORAGE_WAKE_POLICY=Never
PAPER_STORAGE_WAKE_MAC_ADDRESS=
PAPER_STORAGE_WAKE_BROADCAST_ADDRESS=255.255.255.255

# OCR and processing limits for small home servers.
PAPER_OCR_LANGUAGE=deu+eng
PAPER_OCR_PDF_RENDER_DPI=200
PAPER_OCR_MAX_PDF_PAGES=100
PAPER_OCR_PROCESS_TIMEOUT_SECONDS=300
PAPER_PROCESSING_OCR_WORKERS=1
PAPER_PROCESSING_POLL_SECONDS=3
PAPER_CONSUME_POLL_SECONDS=15
PAPER_CONSUME_EMAIL_ATTACHMENTS=true

# Optional IMAP import. It remains disabled unless explicitly enabled.
PAPER_MAIL_ENABLED=false
PAPER_MAIL_HOST=
PAPER_MAIL_PORT=993
PAPER_MAIL_USE_SSL=true
PAPER_MAIL_USERNAME=
PAPER_MAIL_PASSWORD=
PAPER_MAIL_FOLDER=INBOX
PAPER_MAIL_POLL_SECONDS=300
PAPER_MAIL_MAX_MESSAGES_PER_RUN=10
PAPER_MAIL_ONLY_UNREAD=true
PAPER_MAIL_MARK_SEEN=false
PAPER_MAIL_FROM_CONTAINS=
PAPER_MAIL_SUBJECT_CONTAINS=
PAPER_MAIL_ATTACHMENT_EXTENSIONS=.pdf,.jpg,.jpeg,.png,.tif,.tiff
# For multiple accounts, provide a JSON array through this variable.
PAPER_MAIL_ACCOUNTS_JSON=
