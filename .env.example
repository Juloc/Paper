PAPER_ADMIN_USERNAME=admin
PAPER_ADMIN_PASSWORD=change-me-now
PAPER_POSTGRES_PASSWORD=change-me-now

# Optional OCR resource limit (30-1800 seconds per external OCR process)
# PAPER_OCR_MAX_PDF_PAGES=100
# PAPER_OCR_PROCESS_TIMEOUT_SECONDS=300

# Optional direct SMB/NAS storage (use smb://server/share/path or \\\\server\\share\\path)
# PAPER_STORAGE_PROVIDER=smb
# PAPER_STORAGE_SMB_ROOT_PATH=smb://nas/documents
# PAPER_STORAGE_SMB_USERNAME=
# PAPER_STORAGE_SMB_PASSWORD=
# PAPER_STORAGE_SMB_DOMAIN=
# PAPER_STORAGE_WAKE_POLICY=Never
# PAPER_STORAGE_WAKE_MAC_ADDRESS=
# PAPER_STORAGE_WAKE_BROADCAST_ADDRESS=255.255.255.255

# Optional IMAP import (disabled by default)
PAPER_MAIL_ENABLED=false
PAPER_MAIL_HOST=
PAPER_MAIL_USERNAME=
PAPER_MAIL_PASSWORD=
PAPER_MAIL_FOLDER=INBOX
# PAPER_MAIL_FROM_CONTAINS=
# PAPER_MAIL_SUBJECT_CONTAINS=
# PAPER_MAIL_ATTACHMENT_EXTENSIONS=.pdf,.jpg,.jpeg,.png,.tif,.tiff
# Alternativ mehrere Konten als JSON setzen (überschreibt das Einzelkonto):
# PAPER_MAIL_ACCOUNTS_JSON=[{"Enabled":true,"AccountName":"private","Host":"imap.example.com","Username":"user","Password":"secret"}]
