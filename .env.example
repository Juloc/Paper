# Optional IMAP import (disabled by default)
PAPER_MAIL_ENABLED=false
PAPER_MAIL_HOST=
PAPER_MAIL_USERNAME=
PAPER_MAIL_PASSWORD=
PAPER_MAIL_FOLDER=INBOX
